# Copy this file to .env and fill in your key. The .env file is git-ignored.
# DeepSeek API key (OpenAI-compatible). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides (defaults are fine for local Docker use):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# CV_PATH=/data/cv.pdf
# MAX_ANALYSIS_PER_SEARCH=30

# iOS app: every API route is also served as /mobile/<route>, guarded by the X-Api-Key header.
# Unset = /mobile/ answers 503. Generate with: openssl rand -hex 32 (see docs/mobile-api.md)
# MOBILE_API_KEY=
